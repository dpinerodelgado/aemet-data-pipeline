# Clave gratuita: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Código de municipio AEMET (INE), 28079 = Madrid capital
AEMET_MUNICIPIO_ID=28079

# Cadena de conexión SQLAlchemy.
# Homelab (Postgres):  postgresql+psycopg2://aemet:aemet@postgres:5432/aemet
# CI / local rápido (SQLite): sqlite:///aemet.db
DATABASE_URL=sqlite:///aemet.db

# Opcional: URL de push de un monitor "Push" de Uptime Kuma.
# Si se deja vacío, el pipeline simplemente no notifica su estado.
UPTIME_KUMA_PUSH_URL=
